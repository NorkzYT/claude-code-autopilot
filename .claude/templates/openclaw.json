{
  "$schema": "https://openclaw.dev/schema/config.json",
  "models": {
    "mode": "merge",
    "providers": {
      "claude-max-proxy": {
        "baseUrl": "http://claude-max-proxy:3456/v1",
        "api": "openai-completions",
        "auth": "api-key",
        "apiKey": "ignored",
        "timeoutSeconds": 1800,
        "models": [
          {
            "id": "claude-sonnet",
            "name": "Claude Sonnet (latest, Max Proxy)"
          },
          {
            "id": "claude-opus",
            "name": "Claude Opus (latest, Max Proxy)"
          },
          {
            "id": "claude-fable",
            "name": "Claude Fable (latest, Max Proxy)"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "timeoutSeconds": 7200,
      "subagents": {
        "runTimeoutSeconds": 3600
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "30m"
      },
      "models": {
        "claude-max-proxy/claude-sonnet": {
          "alias": "sonnet"
        },
        "claude-max-proxy/claude-opus": {
          "alias": "opus"
        },
        "claude-max-proxy/claude-fable": {
          "alias": "fable"
        }
      },
      "model": {
        "primary": "claude-max-proxy/claude-opus"
      },
      "compaction": {
        "mode": "safeguard"
      }
    }
  },
  "diagnostics": {
    "stuckSessionWarnMs": 600000,
    "stuckSessionAbortMs": 1200000
  },
  "gateway": {
    "mode": "local",
    "port": 18789
  },
  "browser": {
    "enabled": true,
    "headless": true
  },
  "messages": {
    "groupChat": {
      "historyLimit": 20
    }
  },
  "cron": {
    "enabled": true
  },
  "channels": {
    "discord": {
      "enabled": false
    }
  }
}
